{{ if and (eq .profile "personal") (eq .chezmoi.os "darwin") -}}
#!/bin/bash
# Reruns whenever .chezmoidata/packages.yaml changes.
# packages hash: {{ include ".chezmoidata/packages.yaml" | sha256sum }}
set -euo pipefail
export PATH="/opt/local/bin:/opt/local/sbin:$PATH"

# npm12 conflicts with npm10, which older installs have active.
if port -q installed npm10 2>/dev/null | grep -q '(active)'; then
  sudo port -f deactivate npm10
fi

sudo port -N install{{ range .ports }} {{ . }}{{ end }}

if command -v mas >/dev/null 2>&1; then
{{- range .mas }}
  mas list | grep -qE '^ *{{ .id }} ' || mas install {{ .id }}  # {{ .name }}
{{- end }}
fi
{{ end -}}
