{{ if and (eq .profile "personal") (eq .chezmoi.os "darwin") -}}
#!/bin/bash
# Install MacPorts from the official pkg matching this macOS major version.
set -euo pipefail
[ -x /opt/local/bin/port ] && exit 0

xcode-select -p >/dev/null 2>&1 || { echo "Install Xcode Command Line Tools first: xcode-select --install" >&2; exit 1; }

major=$(sw_vers -productVersion | cut -d. -f1)
[ "$major" = 10 ] && major=$(sw_vers -productVersion | cut -d. -f1-2)
url=$(curl -fsSL https://api.github.com/repos/macports/macports-base/releases/latest \
  | grep -oE '"browser_download_url": *"[^"]+-'"$major"'-[A-Za-z]+\.pkg"' | grep -oE 'https://[^"]+')
[ -n "$url" ] || { echo "No MacPorts pkg for macOS $major" >&2; exit 1; }

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
curl -fsSL -o "$tmp/macports.pkg" "$url"
pkgutil --check-signature "$tmp/macports.pkg" | grep -q 'Developer ID Installer' || { echo "MacPorts pkg signature check failed" >&2; exit 1; }
sudo installer -pkg "$tmp/macports.pkg" -target /
sudo /opt/local/bin/port -N selfupdate
{{ end -}}
