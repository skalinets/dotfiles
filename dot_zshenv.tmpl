# Managed by chezmoi.
# Debian/Ubuntu /etc/zsh/zshrc runs its own compinit unless this is set; ~/.zshrc runs it once.
skip_global_compinit=1
{{- if eq .profile "personal" }}

# Plannotator: serve on the tailnet name so plans open from other devices.
export PLANNOTATOR_REMOTE=1
export PLANNOTATOR_PORT=19432-19441
{{- end }}
