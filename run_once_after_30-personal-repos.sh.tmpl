{{ if eq .profile "personal" -}}
#!/bin/bash
# Private repos. Each URL is asked once at init; an empty answer skips that repo.
set -euo pipefail

{{ if .nvimRepo -}}
[ -d ~/.config/nvim ] || git clone {{ .nvimRepo | quote }} ~/.config/nvim
{{- end }}

{{ if .agentsRepo -}}
if [ ! -d ~/.agents ]; then
  git clone {{ .agentsRepo | quote }} ~/.agents
  ~/.agents/bin/agentcfg link
fi
{{- end }}
{{ end -}}
