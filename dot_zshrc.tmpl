# Managed by chezmoi. Machine-specific settings go in ~/.zshrc.local.
{{ if eq .profile "personal" -}}
# Powerlevel10k instant prompt. Must stay near the top.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Source cached output of slow `tool init`-style commands; regenerate when the tool binary changes
_cache_eval() {
  local name=$1; shift
  local f=~/.cache/zsh/$name.zsh bin=${commands[$1]}
  [[ -n $bin ]] || return
  if [[ ! -s $f || $bin -nt $f ]]; then
    mkdir -p ${f:h}
    "$@" >| $f 2>/dev/null
  fi
  source $f
}

export ZSH="$HOME/.oh-my-zsh"
export ZSH_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/oh-my-zsh"  # keeps chezmoi's exact copy of $ZSH clean
ZSH_THEME="powerlevel10k/powerlevel10k"
ZSH_DISABLE_COMPFIX=true
fpath+=(~/.zfunc ~/.oh-my-zsh/completions)
for _site in /opt/local/share/zsh/site-functions /opt/homebrew/share/zsh/site-functions; do
  [[ -d $_site ]] && fpath=($_site $fpath)
done
unset _site
zstyle ':omz:update' mode disabled  # chezmoi refreshes oh-my-zsh weekly
plugins=(git z vi-mode docker docker-compose kubectl helm aws gcloud gitignore zsh-syntax-highlighting)
source $ZSH/oh-my-zsh.sh

source ~/.config/shell/portable.sh
precmd_functions+=(_reset_mouse)

[[ -f ~/.p10k.zsh ]] && source ~/.p10k.zsh
[[ -f ~/.config/zsh/fzf.zsh ]] && source ~/.config/zsh/fzf.zsh

export LC_ALL=en_US.UTF-8
export EDITOR=nvim
zstyle ':completion:*' menu select

(( $+commands[diff-so-fancy] )) && alias diff=diff-so-fancy
(( $+commands[bat] )) && alias cat=bat
(( $+commands[eza] )) && alias ls=eza
(( $+commands[nvim] )) && alias vim=nvim vi=nvim

# Language toolchains, each only when installed
_cache_eval rbenv rbenv init - --no-rehash
_cache_eval fnm fnm env --use-on-cd --shell zsh
_cache_eval thefuck thefuck --alias
export THEFUCK_PRIORITY="git_hook_bypass=1100"

[[ -f ~/.local/bin/env ]] && source ~/.local/bin/env
export BUN_INSTALL="$HOME/.bun"
export PNPM_HOME="$HOME/Library/pnpm"
export DOTNET_ROOT="$HOME/.dotnet"
for _p in $HOME/.cargo/bin $HOME/.local/share/bob/nvim-bin $HOME/.pub-cache/bin $BUN_INSTALL/bin $PNPM_HOME $HOME/.dotnet; do
  [[ -d $_p ]] && path+=($_p)
done
unset _p

for _gc in /opt/local/libexec/google-cloud-sdk /opt/homebrew/share/google-cloud-sdk; do
  if [[ -f $_gc/completion.zsh.inc ]]; then [[ -f $_gc/path.zsh.inc ]] && source $_gc/path.zsh.inc; source $_gc/completion.zsh.inc; break; fi
done
unset _gc

# Jev: pin the decision model to the version its policies are tuned on (see agent-config).
export TYPESAFE_MODEL=typesafe/jev-1.13
{{- else -}}
HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt share_history hist_ignore_dups hist_ignore_space
bindkey -e
autoload -Uz compinit && compinit -i -C
zstyle ':completion:*' menu select

source ~/.config/shell/portable.sh
precmd_functions+=(_reset_mouse)

if [[ -n $SSH_CONNECTION ]]; then _hc=yellow; else _hc=green; fi
PROMPT="%F{$_hc}%n@%m%f:%F{blue}%~%f %(?..%F{red}[%?]%f )%# "
unset _hc
{{- end }}

[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local

# Keep dependency-gate shims first in PATH.
[ -f ~/.agents/dep-guard/path.zsh ] && source ~/.agents/dep-guard/path.zsh
